# Normalise text files to LF in the repository.
# MSYS2/GCC/Ninja builds are sensitive to CRLF in generated scripts and shell
# fragments, and a single consistent EOL keeps patches reviewable.
* text=auto eol=lf

# Language and config sources
*.c            text eol=lf
*.h            text eol=lf
*.cpp          text eol=lf
*.hpp          text eol=lf
*.cc           text eol=lf
*.cmake        text eol=lf
CMakeLists.txt text eol=lf
*.json         text eol=lf
*.yml          text eol=lf
*.yaml         text eol=lf
*.md           text eol=lf
*.sh           text eol=lf
.gitignore     text eol=lf
.gitattributes text eol=lf

# Windows-only scripts keep CRLF so cmd.exe parses them correctly.
*.bat          text eol=crlf
*.cmd          text eol=crlf
*.ps1          text eol=crlf

# Binary artefacts must never be EOL-converted.
*.png          binary
*.jpg          binary
*.jpeg         binary
*.bmp          binary
*.gif          binary
*.ico          binary
*.dll          binary
*.exe          binary
*.lib          binary
*.a            binary
*.pdb          binary
*.pk           binary
*.pkx          binary
*.pkB          binary
